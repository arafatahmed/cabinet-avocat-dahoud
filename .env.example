SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set DB_ENGINE=sqlite for local development without a MySQL server.
DB_ENGINE=mysql
DB_NAME=cabinet_dahoud
DB_USER=cabinet_user
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Configure SMTP before enabling password-reset emails in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=contact@avocat-dahoud.com
